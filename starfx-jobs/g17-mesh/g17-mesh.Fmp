PRIVATE LaserPowerOverrideEX AS DOUBLE
PRIVATE LaserFreqOverrideEX AS DOUBLE
PRIVATE LaserSpeedOverrideEX AS DOUBLE

LaserPowerOverrideEX = 1.0
LaserFreqOverrideEX = 1.0
LaserSpeedOverrideEX = 1.0


HMIREADTXT()




;VECTOR9
LaserSpeedOverrideEX = 1.000
LaserPowerOverrideEX = 1.000
LaserFreqOverrideEX = 1.000
COUNTEX = POLYMER_POLYMER_ENGRAVE.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = POLYMER_POLYMER_ENGRAVE.PARAMETERS(_TEMPINT,1)
   IF _TEMPINT = 1
      PASSEX = 1
      PASSEX = PASSEX + 0
   ENDIF
   PASSES PASSEX
   MOVEABS 0.000,0.000
   ROTATEABS 0.000
   TEXTSCALEX 100.000
   IMAGEJUSTIFY 0
   IMAGEHEIGHT 78.4615384615385
   DRAWFVI "C:\\Users\\LaserStar\\Documents\\aa-laser\\starfx-jobs\\g17-mesh\\9.Fvi"
   TEXTSCALEX 100
   TEXTSCALEY 100
NEXT

;VECTOR10
LaserSpeedOverrideEX = 1.000
LaserPowerOverrideEX = 1.000
LaserFreqOverrideEX = 1.000
COUNTEX = POLYMER_POLYMER_ENGRAVE.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = POLYMER_POLYMER_ENGRAVE.PARAMETERS(_TEMPINT,0)
   IF _TEMPINT = 1
      PASSEX = 1
      PASSEX = PASSEX + 0
   ENDIF
   FILLTYPE 0
   PASSES PASSEX
   MOVEABS 0.000,0.000
   ROTATEABS 0.000
   TEXTSCALEX 100.000
   IMAGEJUSTIFY 0
   IMAGEHEIGHT 78.4615384615385
   DRAWFVI "C:\\Users\\LaserStar\\Documents\\aa-laser\\starfx-jobs\\g17-mesh\\10.Fvi"
   TEXTSCALEX 100
   TEXTSCALEY 100
NEXT
RETURN


CLASS POLYMER_POLYMER_ENGRAVE

FUNCTION Count()
   RETURN 1
ENDFUNCTION

FUNCTION Parameters(I AS INTEGER, FILL AS INTEGER)
   SELECT i
   CASE 1
      DRAWSPEED 4000.000 * LaserSpeedOverrideEX
      LASERWATTS 39.100 * LaserPowerOverrideEX
      LASERFREQ 60.000 * LaserFreqOverrideEX
      MOVESPEED 8000.000
      LASERDUTY 200.000
      TC 0,10
      TC 1,150
      TC 2,150
      TC 3,200
      TC 4,190
      TC 5,160
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.000,0.000
      IF FILL == 0
         FILLTYPE 0
      ELSE
         POINT 25,25
         OBJECTFILL 0
         DEFFILL 1,"2,90.000,0.100,0.000,0"
         USEFILL 1
         FILLTYPE 1
      ENDIF
      RETURN 1
   ENDSELECT
ENDFUNCTION

FUNCTION AutoRotate(I AS INTEGER)
   SELECT i
   CASE 1
      RETURN 0
   ENDSELECT
ENDFUNCTION

ENDCLASS


