LaserPowerOverrideEX = 1.000
LaserFreqOverrideEX = 1.000
COUNTEX = ALUMINUM_DEEP_ENGRAVE_ALUMINUM.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = ALUMINUM_DEEP_ENGRAVE_ALUMINUM.PARAMETERS(_TEMPINT,1)
