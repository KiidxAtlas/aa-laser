LaserFreqOverrideEX = 1.000
COUNTEX = 2D_TEXTURES_ALUMINUM_BLACK_CEMENT_SURFACE_MARK_ALUMINUM_60W2D.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = 2D_TEXTURES_ALUMINUM_BLACK_CEMENT_SURFACE_MARK_ALUMINUM_60W2D.PARAMETERS(_TEMPINT,1)
   IF _TEMPINT = 1
      PASSEX = 1
      PASSEX = PASSEX + 0
   ENDIF
   PASSES PASSEX
   TEXTLINE
   TEXTHEIGHT 4.000
   USETTF 1
   TTFREGULAR
   TEXTSCALEX 100.000
   TEXTSCALEY 100.000
   TEXTJUSTIFYC 200
   TEXTHEIGHT 4.000
   MOVEABS 0.207,0.415
   ROTATEABS 0.000
   DRAWTEXT "GSF"
