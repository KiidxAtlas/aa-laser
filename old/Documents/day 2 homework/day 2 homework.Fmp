CLASS 2D_TEXTURES_ALUMINUM_BLACK_CEMENT_SURFACE_MARK_ALUMINUM_60W2D

FUNCTION Count()
   RETURN 3
ENDFUNCTION

FUNCTION Parameters(I AS INTEGER, FILL AS INTEGER)
   SELECT i
   CASE 1
      DRAWSPEED 200.000 * LaserSpeedOverrideEX
      LASERWATTS 26.150 * LaserPowerOverrideEX
      LASERFREQ 30.000 * LaserFreqOverrideEX
      MOVESPEED 4000.000
      LASERDUTY 200.000
      TC 0,10
      TC 1,150
      TC 2,150
      TC 3,200
      TC 4,190
      TC 5,160
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.000,0.000
      IF FILL == 0
         FILLTYPE 0
      ELSE
         POINT 0, 0
         OBJECTFILL 0
         DEFFILL 1,"2,45.000,0.025,0.000,0"
         USEFILL 1
         FILLTYPE 1
      ENDIF
      RETURN 1
   CASE 2
      DRAWSPEED 300.000
      LASERWATTS 56.500
      LASERFREQ 60.000
      MOVESPEED 4000.000
      LASERDUTY 200.000
      TC 0,10
      TC 1,150
      TC 2,150
      TC 3,200
      TC 4,190
      TC 5,160
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.000,0.000
      IF FILL == 0
         FILLTYPE 0
      ELSE
         POINT 0, 0
         OBJECTFILL 0
         DEFFILL 1,"2,-45.000,0.100,0.000,0"
         USEFILL 1
         FILLTYPE 1
      ENDIF
      RETURN 1
   CASE 3
      DRAWSPEED 100.000
      LASERWATTS 56.500
      LASERFREQ 30.000
      MOVESPEED 4000.000
      LASERDUTY 200.000
      TC 0,10
      TC 1,150
      TC 2,150
      TC 3,300
      TC 4,190
      TC 5,160
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.000,0.000
      IF FILL == 0
         FILLTYPE 0
      ELSE
         POINT 0, 0
         OBJECTFILL 0
         DEFFILL 1,"2,45.000,0.030,0.000,0"
         USEFILL 1
         FILLTYPE 2
      ENDIF
      RETURN 1
   ENDSELECT
ENDFUNCTION

FUNCTION AutoRotate(I AS INTEGER)
   SELECT i
   CASE 1
      RETURN 0
   CASE 2
      RETURN 0
   CASE 3
      RETURN 0
   ENDSELECT
ENDFUNCTION

ENDCLASS



