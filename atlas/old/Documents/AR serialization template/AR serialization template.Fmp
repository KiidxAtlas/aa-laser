SPECIALFUNCTION 1, 0, Begin
SPECIALFUNCTION 1, 1, End
PRIVATE _TRACECOUNT AS INTEGER
PRIVATE PASSEX AS INTEGER
PRIVATE _PASSEX AS INTEGER
PRIVATE COUNTEX AS INTEGER
PRIVATE _TEMPINT AS INTEGER
PRIVATE TRACEEX AS INTEGER
PRIVATE _TRACEEX AS STRING
PRIVATE _CAMERAEX AS STRING
PRIVATE _N AS INTEGER
PRIVATE _S, _SX, _SY AS STRING
PRIVATE SX, SY AS INTEGER
PRIVATE _POSITIONS AS STRING
PRIVATE _TEMPSTRING AS STRING
PRIVATE _DEPTH AS INTEGER
PRIVATE FILLANGLE AS DOUBLE

PRIVATE LITERAL_1 AS STRING
/LITERAL_1="MOD: AAM4"

PRIVATE LaserPowerOverrideEX AS DOUBLE
PRIVATE LaserFreqOverrideEX AS DOUBLE
PRIVATE LaserSpeedOverrideEX AS DOUBLE

LaserPowerOverrideEX = 1.0
LaserFreqOverrideEX = 1.0
LaserSpeedOverrideEX = 1.0



DEFTTF 1,"TAHOMA"
HMIREADTXT()




;MULTILINETEXT1
LaserSpeedOverrideEX = 1.000
LaserPowerOverrideEX = 1.000
LaserFreqOverrideEX = 1.000
COUNTEX = ALUMINUM_DEEP_ENGRAVE_ALUMINUM.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = ALUMINUM_DEEP_ENGRAVE_ALUMINUM.PARAMETERS(_TEMPINT,1)
   IF _TEMPINT = 1
      PASSEX = 34
   ENDIF
   PASSES PASSEX
   TEXTLINE
   TEXTHEIGHT 4.840
   USETTF 1
   TTFREGULAR
   TEXTSCALEX 100.000
   TEXTSCALEY 100.000
   TEXTJUSTIFYC 200
   SPACING 0.500
   TEXTHEIGHT 4.840
   MOVEABS -1.174,5.008
   ROTATEABS 0.000
   DRAWTEXT "MOD: AAM4"
   TEXTJUSTIFYC 200
   SPACING 0.500
   TEXTHEIGHT 4.840
   MOVEABS -1.304,-2.471
   ROTATEABS 0.000
   DRAWTEXT "CAL: MULTI"
   TEXTJUSTIFYC 200
   SPACING 0.500
   TEXTHEIGHT 4.840
   MOVEABS 0.000,-9.949
   ROTATEABS 0.000
   DRAWTEXT "S/N: 062626"
   SPACING 0
NEXT
RETURN


CLASS ALUMINUM_DEEP_ENGRAVE_ALUMINUM

FUNCTION Count()
   RETURN 1
ENDFUNCTION

FUNCTION Parameters(I AS INTEGER, FILL AS INTEGER)
   SELECT i
   CASE 1
      DRAWSPEED 1800.000 * LaserSpeedOverrideEX
      LASERWATTS 56.500 * LaserPowerOverrideEX
      LASERFREQ 60.000 * LaserFreqOverrideEX
      MOVESPEED 3500.000
      LASERDUTY 200.000
      TC 0,10
      TC 1,150
      TC 2,150
      TC 3,200
      TC 4,190
      TC 5,160
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.000,0.000
      IF FILL == 0
         FILLTYPE 0
      ELSE
         POINT 0, 0
         OBJECTFILL 0
         DEFFILL 1,"2,90.000,0.030,0.000,0"
         USEFILL 1
         FILLTYPE 1
      ENDIF
      RETURN 1
   ENDSELECT
ENDFUNCTION

FUNCTION AutoRotate(I AS INTEGER)
   SELECT i
   CASE 1
      RETURN 0
   ENDSELECT
ENDFUNCTION

ENDCLASS


FUNCTION HMIREADTXT()
ENDFUNCTION

FUNCTION Begin()
ENDFUNCTION

FUNCTION End()
PRIVATE VarRemoteWrite AS STRING
ENDFUNCTION
