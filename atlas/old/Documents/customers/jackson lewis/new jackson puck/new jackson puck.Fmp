PRIVATE LITERAL_5 AS STRING
/LITERAL_5="Thank you, Coach Joe!"

PRIVATE LaserPowerOverrideEX AS DOUBLE
PRIVATE LaserFreqOverrideEX AS DOUBLE
PRIVATE LaserSpeedOverrideEX AS DOUBLE

LaserPowerOverrideEX = 1.0
LaserFreqOverrideEX = 1.0
LaserSpeedOverrideEX = 1.0



DEFTTF 1,"TAHOMA"
HMIREADTXT()




;CIRCULARTEXT5
LaserSpeedOverrideEX = 1.000
LaserPowerOverrideEX = 1.000
LaserFreqOverrideEX = 1.000
COUNTEX = _CUSTOMMATERIAL_TASSOS_FUNK_PUCK.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = _CUSTOMMATERIAL_TASSOS_FUNK_PUCK.PARAMETERS(_TEMPINT,1)
   IF _TEMPINT = 1
      PASSEX = 1
      PASSEX = PASSEX + 4
   ENDIF
   PASSES PASSEX
   TEXTCIRCLE
   MOVEABS 0.000,0.000
   TEXTCW
   ROTATEABS -78.002
   TEXTRADIUS 23.201
   TEXTHEIGHT 9.000
   TEXTSCALEX 100.000
   TEXTSCALEY 100.000
   USETTF 1
   TTFREGULAR
   TTFBOLD
   DRAWTEXT "Thank you, Coach Joe!"
   TEXTLINE
   SPACING 0
NEXT

;VECTOR7
LaserSpeedOverrideEX = 1.000
LaserPowerOverrideEX = 1.000
LaserFreqOverrideEX = 1.000
COUNTEX = _CUSTOMMATERIAL_TASSOS_FUNK_PUCK.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = _CUSTOMMATERIAL_TASSOS_FUNK_PUCK.PARAMETERS(_TEMPINT,1)
   IF _TEMPINT = 1
      PASSEX = 1
      PASSEX = PASSEX + 4
   ENDIF
   PASSES PASSEX
   MOVEABS 0.000,0.000
   ROTATEABS 0.000
   TEXTSCALEX 100.000
   IMAGEJUSTIFY 0
   IMAGEHEIGHT 19.424
   DRAWFVI "C:\\LaserStar\\StarFXPremier\\Documents\\customers\\jackson lewis\\new jackson puck\\7.Fvi"
   TEXTSCALEX 100
   TEXTSCALEY 100
NEXT
RETURN


CLASS _CUSTOMMATERIAL_TASSOS_FUNK_PUCK

FUNCTION Count()
   RETURN 1
ENDFUNCTION

FUNCTION Parameters(I AS INTEGER, FILL AS INTEGER)
   SELECT i
   CASE 1
      DRAWSPEED 1800.000 * LaserSpeedOverrideEX
      LASERWATTS 40.000 * LaserPowerOverrideEX
      LASERFREQ 200.000 * LaserFreqOverrideEX
      MOVESPEED 4000.000
      LASERDUTY 200.000
      TC 0,10
      TC 1,150
      TC 2,150
      TC 3,200
      TC 4,190
      TC 5,160
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.000,0.000
      IF FILL == 0
         FILLTYPE 0
      ELSE
         POINT 0, 0
         OBJECTFILL 0
         DEFFILL 1,"0,45.000,0.030,0.000,0"
         USEFILL 1
         FILLTYPE 1
      ENDIF
      RETURN 1
   ENDSELECT
ENDFUNCTION

FUNCTION AutoRotate(I AS INTEGER)
   SELECT i
   CASE 1
      RETURN 0
   ENDSELECT
ENDFUNCTION

ENDCLASS


