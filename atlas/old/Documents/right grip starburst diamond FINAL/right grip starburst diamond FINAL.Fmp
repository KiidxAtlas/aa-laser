SPECIALFUNCTION 1, 0, Begin
SPECIALFUNCTION 1, 1, End
PRIVATE _TRACECOUNT AS INTEGER
PRIVATE PASSEX AS INTEGER
PRIVATE _PASSEX AS INTEGER
PRIVATE COUNTEX AS INTEGER
PRIVATE _TEMPINT AS INTEGER
PRIVATE TRACEEX AS INTEGER
PRIVATE _TRACEEX AS STRING
PRIVATE _CAMERAEX AS STRING
PRIVATE _N AS INTEGER
PRIVATE _S, _SX, _SY AS STRING
PRIVATE SX, SY AS INTEGER
PRIVATE _POSITIONS AS STRING
PRIVATE _TEMPSTRING AS STRING
PRIVATE _DEPTH AS INTEGER
PRIVATE FILLANGLE AS DOUBLE

PRIVATE LaserPowerOverrideEX AS DOUBLE
PRIVATE LaserFreqOverrideEX AS DOUBLE
PRIVATE LaserSpeedOverrideEX AS DOUBLE

LaserPowerOverrideEX = 1.0
LaserFreqOverrideEX = 1.0
LaserSpeedOverrideEX = 1.0


HMIREADTXT()




;VECTOR1
LaserSpeedOverrideEX = 1.000
LaserPowerOverrideEX = 1.000
LaserFreqOverrideEX = 1.000
COUNTEX = _CUSTOMMATERIAL_POLY_TEST.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = _CUSTOMMATERIAL_POLY_TEST.PARAMETERS(_TEMPINT,0)
   IF _TEMPINT = 1
      PASSEX = 1
      PASSEX = PASSEX + 0
   ENDIF
   FILLTYPE 0
   PASSES PASSEX
   MOVEABS 0.000,0.000
   ROTATEABS 270.000
   TEXTSCALEX 100.000
   IMAGEJUSTIFY 0
   IMAGEHEIGHT 80
   DRAWFVI "C:\\LaserStar\\StarFXPremier\\Documents\\right grip starburst diamond FINAL\\1.Fvi"
   TEXTSCALEX 100
   TEXTSCALEY 100
NEXT

;VECTOR2
LaserSpeedOverrideEX = 1.000
LaserPowerOverrideEX = 1.000
LaserFreqOverrideEX = 1.000
COUNTEX = _CUSTOMMATERIAL_POLY_TEST.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = _CUSTOMMATERIAL_POLY_TEST.PARAMETERS(_TEMPINT,1)
   IF _TEMPINT = 1
      PASSEX = 1
      PASSEX = PASSEX + 0
   ENDIF
   PASSES PASSEX
   MOVEABS -0.063,0.000
   ROTATEABS 270.000
   TEXTSCALEX 100.000
   IMAGEJUSTIFY 0
   IMAGEHEIGHT 79.9785
   DRAWFVI "C:\\LaserStar\\StarFXPremier\\Documents\\right grip starburst diamond FINAL\\2.Fvi"
   TEXTSCALEX 100
   TEXTSCALEY 100
NEXT
RETURN


CLASS _CUSTOMMATERIAL_POLY_TEST

FUNCTION Count()
   RETURN 1
ENDFUNCTION

FUNCTION Parameters(I AS INTEGER, FILL AS INTEGER)
   SELECT i
   CASE 1
      DRAWSPEED 1100.000 * LaserSpeedOverrideEX
      LASERWATTS 8.000 * LaserPowerOverrideEX
      LASERFREQ 60.000 * LaserFreqOverrideEX
      MOVESPEED 4000.000
      LASERDUTY 200.000
      TC 0,10
      TC 1,150
      TC 2,150
      TC 3,200
      TC 4,190
      TC 5,160
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.000,0.000
      IF FILL == 0
         FILLTYPE 0
      ELSE
         POINT 0, 0
         OBJECTFILL 0
         DEFFILL 1,"0,50.000,0.090,0.000,0"
         USEFILL 1
         FILLTYPE 1
      ENDIF
      RETURN 1
   ENDSELECT
ENDFUNCTION

FUNCTION AutoRotate(I AS INTEGER)
   SELECT i
   CASE 1
      RETURN 0
   ENDSELECT
ENDFUNCTION

ENDCLASS


FUNCTION HMIREADTXT()
ENDFUNCTION

FUNCTION Begin()
ENDFUNCTION

FUNCTION End()
