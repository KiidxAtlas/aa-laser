SPECIALFUNCTION 1, 0, Begin
SPECIALFUNCTION 1, 1, End
PRIVATE _TRACECOUNT AS INTEGER
PRIVATE PASSEX AS INTEGER
PRIVATE _PASSEX AS INTEGER
PRIVATE COUNTEX AS INTEGER
PRIVATE _TEMPINT AS INTEGER
PRIVATE TRACEEX AS INTEGER
PRIVATE _TRACEEX AS STRING
PRIVATE _CAMERAEX AS STRING
PRIVATE _N AS INTEGER
PRIVATE _S, _SX, _SY AS STRING
PRIVATE SX, SY AS INTEGER
PRIVATE _POSITIONS AS STRING
PRIVATE _TEMPSTRING AS STRING
PRIVATE _DEPTH AS INTEGER
PRIVATE FILLANGLE AS DOUBLE

PRIVATE LITERAL_1 AS STRING
/LITERAL_1="accurate arms"

PRIVATE LITERAL_2 AS STRING
/LITERAL_2="ian rutherford"

PRIVATE LITERAL_4 AS STRING
/LITERAL_4="925-368-6505"

PRIVATE LaserPowerOverrideEX AS DOUBLE
PRIVATE LaserFreqOverrideEX AS DOUBLE
PRIVATE LaserSpeedOverrideEX AS DOUBLE

LaserPowerOverrideEX = 1.0
LaserFreqOverrideEX = 1.0
LaserSpeedOverrideEX = 1.0



DEFTTF 1,"STENCIL"
DEFTTF 2,"ARIAL NARROW"
HMIREADTXT()




;MULTILINETEXT1
LaserSpeedOverrideEX = 1.000
LaserPowerOverrideEX = 1.000
LaserFreqOverrideEX = 1.000
COUNTEX = ALUMINUM_WHITE_MARK_ON_ALUMINUM.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = ALUMINUM_WHITE_MARK_ON_ALUMINUM.PARAMETERS(_TEMPINT,1)
   IF _TEMPINT = 1
      PASSEX = 1
      PASSEX = PASSEX + 1
   ENDIF
   PASSES PASSEX
   TEXTLINE
   TEXTHEIGHT 6.000
   USETTF 1
   TTFREGULAR
   TTFITALIC
   TEXTSCALEX 100.000
   TEXTSCALEY 100.000
   TEXTJUSTIFYC 200
   TEXTHEIGHT 6.000
   MOVEABS 0.000,-3.062
   ROTATEABS 0.000
   DRAWTEXT "accurate arms"
   SPACING 0
NEXT

;MULTILINETEXT2
LaserSpeedOverrideEX = 1.000
LaserPowerOverrideEX = 1.000
LaserFreqOverrideEX = 1.000
COUNTEX = ALUMINUM_WHITE_MARK_ON_ALUMINUM.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = ALUMINUM_WHITE_MARK_ON_ALUMINUM.PARAMETERS(_TEMPINT,1)
   IF _TEMPINT = 1
      PASSEX = 1
      PASSEX = PASSEX + 1
   ENDIF
   PASSES PASSEX
   TEXTLINE
   TEXTHEIGHT 4.000
   USETTF 1
   TTFREGULAR
   TEXTSCALEX 100.000
   TEXTSCALEY 100.000
   TEXTJUSTIFYC 200
   TEXTHEIGHT 4.000
   MOVEABS -0.289,-10.621
   ROTATEABS 0.000
   DRAWTEXT "ian rutherford"
   SPACING 0
NEXT

;MULTILINETEXT4
LaserSpeedOverrideEX = 1.000
LaserPowerOverrideEX = 1.000
LaserFreqOverrideEX = 1.000
COUNTEX = ALUMINUM_WHITE_MARK_ON_ALUMINUM.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = ALUMINUM_WHITE_MARK_ON_ALUMINUM.PARAMETERS(_TEMPINT,1)
   IF _TEMPINT = 1
      PASSEX = 1
      PASSEX = PASSEX + 1
   ENDIF
   PASSES PASSEX
   TEXTLINE
   TEXTHEIGHT 4.000
   USETTF 2
   TTFREGULAR
   TEXTSCALEX 100.000
   TEXTSCALEY 100.000
   TEXTJUSTIFYC 200
   TEXTHEIGHT 4.000
   MOVEABS 0.579,-19.172
   ROTATEABS 0.000
   DRAWTEXT "925-368-6505"
   SPACING 0
NEXT
RETURN


CLASS ALUMINUM_WHITE_MARK_ON_ALUMINUM

FUNCTION Count()
   RETURN 1
ENDFUNCTION

FUNCTION Parameters(I AS INTEGER, FILL AS INTEGER)
   SELECT i
   CASE 1
      DRAWSPEED 1800.000 * LaserSpeedOverrideEX
      LASERWATTS 10.670 * LaserPowerOverrideEX
      LASERFREQ 60.000 * LaserFreqOverrideEX
      MOVESPEED 3500.000
      LASERDUTY 50.000
      TC 0,10
      TC 1,150
      TC 2,150
      TC 3,200
      TC 4,190
      TC 5,160
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.000,0.000
      IF FILL == 0
         FILLTYPE 0
      ELSE
         POINT 0, 0
         OBJECTFILL 0
         DEFFILL 1,"2,90.000,0.030,0.000,0"
         USEFILL 1
         FILLTYPE 1
      ENDIF
      RETURN 1
   ENDSELECT
ENDFUNCTION

FUNCTION AutoRotate(I AS INTEGER)
   SELECT i
   CASE 1
      RETURN 0
   ENDSELECT
ENDFUNCTION

ENDCLASS


FUNCTION HMIREADTXT()
ENDFUNCTION

FUNCTION Begin()
ENDFUNCTION

FUNCTION End()
PRIVATE VarRemoteWrite AS STRING
