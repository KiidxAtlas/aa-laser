SPECIALFUNCTION 1, 0, Begin
SPECIALFUNCTION 1, 1, End
PRIVATE _TRACECOUNT AS INTEGER
PRIVATE PASSEX AS INTEGER
PRIVATE _PASSEX AS INTEGER
PRIVATE COUNTEX AS INTEGER
PRIVATE _TEMPINT AS INTEGER
PRIVATE TRACEEX AS INTEGER
PRIVATE _TRACEEX AS STRING
PRIVATE _CAMERAEX AS STRING
PRIVATE _N AS INTEGER
PRIVATE _S, _SX, _SY AS STRING
PRIVATE SX, SY AS INTEGER
PRIVATE _POSITIONS AS STRING
PRIVATE _TEMPSTRING AS STRING
PRIVATE _DEPTH AS INTEGER
PRIVATE FILLANGLE AS DOUBLE

PRIVATE LITERAL_1 AS STRING
/LITERAL_1="30-378"

PRIVATE LaserPowerOverrideEX AS DOUBLE
PRIVATE LaserFreqOverrideEX AS DOUBLE
PRIVATE LaserSpeedOverrideEX AS DOUBLE

LaserPowerOverrideEX = 1.0
LaserFreqOverrideEX = 1.0
LaserSpeedOverrideEX = 1.0



DEFTTF 1,"SEGOE UI SYMBOL"
HMIREADTXT()




;MULTILINETEXT1
LaserSpeedOverrideEX = 1.0
LaserPowerOverrideEX = 1.0
LaserFreqOverrideEX = 1.0
COUNTEX = DEFAULT_DEFAULT.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   PASSEX = DEFAULT_DEFAULT.PARAMETERS(_TEMPINT,1)
   IF _TEMPINT = 1
      PASSEX = 2
      FILLANGLE = 90.000
      DEFFILL 1, "5,90.000,0.010,0.000,0"
      USEFILL 1
      FILLTYPE 1
      DRAWSPEED 1000.000
      LASERWATTS 20.000
      LASERFREQ 30.000
   ENDIF
   PASSES PASSEX
   TEXTLINE
   TEXTHEIGHT 4.000
   USETTF 1
   TTFREGULAR
   TEXTSCALEX 100.000
   TEXTSCALEY 100.000
   TEXTJUSTIFYC 200
   TEXTHEIGHT 4.000
   MOVEABS 0.000,-2.034
   ROTATEABS 0.000
   DRAWTEXT "30-378"
   SPACING 0
NEXT
RETURN


CLASS DEFAULT_DEFAULT

FUNCTION Count()
   RETURN 2
ENDFUNCTION

FUNCTION Parameters(I AS INTEGER, FILL AS INTEGER)
   SELECT i
   CASE 1
      DRAWSPEED 1800.000 * LaserSpeedOverrideEX
      LASERWATTS 26.150 * LaserPowerOverrideEX
      LASERFREQ 60.000 * LaserFreqOverrideEX
      MOVESPEED 3500.000
      LASERDUTY 200.000
      TC 0,10
      TC 1,150
      TC 2,150
      TC 3,200
      TC 4,190
      TC 5,160
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.000,0.000
      IF FILL == 0
         FILLTYPE 0
      ELSE
         POINT 0, 0
         OBJECTFILL 0
         FILLTYPE 0
      ENDIF
      RETURN 1
   CASE 2
      DRAWSPEED 1800.000
      LASERWATTS 26.150
      LASERFREQ 60.000
      MOVESPEED 3500.000
      LASERDUTY 110.000
      TC 0,10
      TC 1,150
      TC 2,150
      TC 3,200
      TC 4,190
      TC 5,160
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.000,0.000
      IF FILL == 0
         FILLTYPE 0
      ELSE
         POINT 0, 0
         OBJECTFILL 0
         FILLTYPE 0
      ENDIF
      RETURN 1
   ENDSELECT
ENDFUNCTION

FUNCTION AutoRotate(I AS INTEGER)
   SELECT i
   CASE 1
      RETURN 0
   CASE 2
      RETURN 0
   ENDSELECT
ENDFUNCTION

ENDCLASS


FUNCTION HMIREADTXT()
ENDFUNCTION

FUNCTION Begin()
ENDFUNCTION

FUNCTION End()
PRIVATE VarRemoteWrite AS STRING
ENDFUNCTION
