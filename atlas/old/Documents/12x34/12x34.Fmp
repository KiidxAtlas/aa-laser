CLASS _CUSTOMMATERIAL_STAINLESS_STEEL_WOBBLE_CUT

FUNCTION Count()
   RETURN 1
ENDFUNCTION

FUNCTION Parameters(I AS INTEGER, FILL AS INTEGER)
   SELECT i
   CASE 1
      DRAWSPEED 50.000 * LaserSpeedOverrideEX
      LASERWATTS 60.000 * LaserPowerOverrideEX
      LASERFREQ 30.000 * LaserFreqOverrideEX
      MOVESPEED 1800.000
      LASERDUTY 200.000
      TC 0,10
      TC 1,150
      TC 2,150
      TC 3,500
      TC 4,190
      TC 5,160
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.800,0.100
      IF FILL == 0
         FILLTYPE 0
      ELSE
         POINT 0, 0
         OBJECTFILL 0
         DEFFILL 1,"8,40.000,0.030,0.000,0"
         USEFILL 1
         FILLTYPE 1
      ENDIF
      RETURN 50
   ENDSELECT
ENDFUNCTION

FUNCTION AutoRotate(I AS INTEGER)
   SELECT i
   CASE 1
      RETURN 0
   ENDSELECT
ENDFUNCTION

ENDCLASS



